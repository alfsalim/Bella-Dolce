# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Requsired for Google Maps Embed API in Delivery Management.
VITE_GOOGLE_MAPS_API_KEY=

# DATABASE_URL: Required for SQLite connection.
DATABASE_URL="file:./dev.db"

COMPOSE_PROJECT_NAME=bella-dolce2

APP_NAME=bella-dolce2
APP_PREFIX=/bella-dolce2
API_VERSION=v1
BACKEND_PORT=3500
FRONTEND_PORT=5273
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bella-dolce2
REDIS_URL=redis://redis:6379
JWT_SECRET=bella-dolce-prod-jwt-secret
JWT_EXPIRES_IN=8h

# NODE_ENV: printer service
# Dev: local simulator on port 5555
PRINT_AGENT_URL=http://localhost:5555
# Prod: real thermal printer IP (update with actual printer IP and port)
PRINT_AGENT_URL_PROD=http://192.168.x.x:9100
PRINT_AGENT_TIMEOUT=2000



# ─────────────────────────────────────────
# G50 Tax Service — Bella-Dolce Client Config
# ─────────────────────────────────────────

# G50 service connection
G50_SERVICE_URL=http://localhost:3100
G50_API_KEY=your-api-key-here

# This company's tenant ID (UUID, generated once, never changes)
G50_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx